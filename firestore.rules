rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isAdmin() { return request.auth != null && request.auth.token.admin == true; }
    function httpsUrl(u) { return u is string && u.matches('^https?://.+'); }
    match /films/{id} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update: if isAdmin() && httpsUrl(request.resource.data.posterUrl) && request.resource.data.status in ['draft','published'];
      allow delete: if isAdmin();
    }
    match /categories/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /siteSettings/{id} { allow read: if true; allow write: if isAdmin(); }
    match /analytics/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['filmId','title','quality','provider','day','createdAt'])
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /admins/{id} { allow read: if isAdmin(); allow write: if false; }
  }
}
